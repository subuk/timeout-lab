{
  "name": "boxes-systems-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build:wasm": "sh scripts/build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "build": "sh scripts/build.sh",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "npm run preview",
    "test": "go test ./... && node scripts/check-i18n.cjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/**/*.tsx\" \"src/*.ts\" \"tests/*.ts\" \"*config.ts\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12"
  }
}
